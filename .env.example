# ── omni-forge environment ─────────────────────────────────────────────
# Copy to .env and fill in whatever free keys you have. Missing keys are
# fine: that provider is simply skipped and the router moves on.

# ── Router ─────────────────────────────────────────────────────────────
FORGE_ROUTER_HOST=127.0.0.1
FORGE_ROUTER_PORT=4010
# preferred logical model exposed to clients (single name, auto failover)
FORGE_ROUTER_MODEL=forge-chat
# per-request timeout seconds
FORGE_ROUTER_TIMEOUT=120
# sqlite ledger path (default data/router.db)
FORGE_ROUTER_DB=./data/router.db

# ── Core (multimodal) ──────────────────────────────────────────────────
FORGE_CORE_HOST=127.0.0.1
FORGE_CORE_PORT=4020
# where generated media lands
FORGE_OUTPUT_DIR=./outputs
# default edge-tts voice
FORGE_EDGE_VOICE=en-US-AriaNeural
# offline TTS: piper binary + model path
FORGE_PIPER_BIN=piper
FORGE_PIPER_MODEL=
# ASR: whisper (openai-whisper / faster-whisper) CLI
FORGE_WHISPER_BIN=whisper
FORGE_WHISPER_MODEL=base
# video: a command with {prompt} and {out} placeholders (e.g. Wan 2.1)
FORGE_WAN_COMMAND=
# ComfyUI workflow template JSON with {prompt},{width},{height},{seed} placeholders
FORGE_COMFY_WORKFLOW=

# ── Free cloud providers (all optional) ────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
HF_TOKEN=
TOGETHER_API_KEY=

# ── Local backends ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
COMFYUI_BASE_URL=http://127.0.0.1:8188
SEARXNG_BASE_URL=http://127.0.0.1:8080
